# Guard pushes to main:
#   1. block if unconsumed changesets are present
#   2. block if committed landing artifacts are stale vs a fresh render
# Run `make release` to consume changesets and regenerate before pushing.
protected="main"

unconsumed=$(ls .changeset/*.md 2>/dev/null | grep -v '/README\.md$' || true)

pushing_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/"$protected")
      pushing_main=1
      ;;
  esac
done

if [ "$pushing_main" -eq 0 ]; then
  exit 0
fi

if [ -n "$unconsumed" ]; then
  echo "pre-push: unconsumed changesets present; run 'make release' before pushing to $protected:" >&2
  echo "$unconsumed" >&2
  exit 1
fi

if command -v node >/dev/null 2>&1; then
  if ! node landing/scripts/build-changelog.mjs >/dev/null 2>&1; then
    echo "pre-push: failed to regenerate landing changelog." >&2
    exit 1
  fi
  if ! git diff --quiet -- landing/; then
    echo "pre-push: landing artifacts are stale; run 'make release' and commit the result before pushing to $protected." >&2
    git --no-pager diff --stat -- landing/ >&2
    exit 1
  fi
fi

exit 0
